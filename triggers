-- 2. TRIGGER: VALIDATE BOOKINGS

CREATE TRIGGER tr_ValidateBooking
ON Bookings
INSTEAD OF INSERT
AS
BEGIN

    --------------------------------------------------
    -- Flight exists

    IF EXISTS (
        SELECT 1
        FROM inserted i
        LEFT JOIN Flights f
            ON i.FlightID = f.FlightID
        WHERE f.FlightID IS NULL
    )
    BEGIN
        RAISERROR('This flight does not exist',16,1);
        ROLLBACK;
        RETURN;
    END;

    --------------------------------------------------
    -- Passenger exists

    IF EXISTS (
        SELECT 1
        FROM inserted i
        LEFT JOIN Passengers p
            ON i.PassengerID = p.PassengerID
        WHERE p.PassengerID IS NULL
    )
    BEGIN
        RAISERROR('This passenger does not exist',16,1);
        ROLLBACK;
        RETURN;
    END;

    --------------------------------------------------
    -- Price cannot be negative

    IF EXISTS (
        SELECT 1
        FROM inserted
        WHERE Price < 0
    )
    BEGIN
        RAISERROR('Price cannot be negative',16,1);
        ROLLBACK;
        RETURN;
    END;

    --------------------------------------------------
    -- Flight capacity validation

    IF EXISTS (
        SELECT 1
        FROM inserted i
        WHERE (
            SELECT COUNT(*)
            FROM Bookings b
            WHERE b.FlightID = i.FlightID
        ) >= 100
    )
    BEGIN
        RAISERROR('Flight is fully booked',16,1);
        ROLLBACK;
        RETURN;
    END;

    --------------------------------------------------
    -- Insert booking

    INSERT INTO Bookings
    (
        FlightID,
        PassengerID,
        SeatNumber,
        BookingDate,
        Class,
        Price,
        CheckedIn
    )
    SELECT
        FlightID,
        PassengerID,
        SeatNumber,
        BookingDate,
        Class,
        Price,
        CheckedIn
    FROM inserted;

END;

