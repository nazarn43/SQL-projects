-- 3. TRIGGER: TRACK FLIGHT CANCELLATIONS

CREATE TRIGGER tr_TrackFlightCancellations
ON Flights
INSTEAD OF DELETE
AS
BEGIN

    --------------------------------------------------
    -- Prevent cancellation within 24 hours

    IF EXISTS (
        SELECT 1
        FROM deleted
        WHERE DepartureTime <= DATEADD(HOUR,24,GETDATE())
    )
    BEGIN
        RAISERROR('Cannot cancel flight within 24 hours',16,1);
        ROLLBACK;
        RETURN;
    END;

    --------------------------------------------------
    -- Save deleted flights

    INSERT INTO FlightCancellations
    (
        FlightNumber,
        DepartureAirport,
        ArrivalAirport,
        OriginalDepartureTime
    )
    SELECT
        FlightNumber,
        DepartureAirport,
        ArrivalAirport,
        DepartureTime
    FROM deleted;

    --------------------------------------------------
    -- Create passenger notifications

    INSERT INTO PassengerNotifications
    (
        PassengerID,
        FlightNumber,
        NotificationType,
        NotificationMessage
    )
    SELECT
        b.PassengerID,
        d.FlightNumber,
        'FlightCancelled',

        'Your flight ' + d.
