-- 1. CREATE AUDIT TABLES

IF NOT EXISTS (
    SELECT *
    FROM sys.tables
    WHERE name = 'FlightCancellations'
)
BEGIN
    CREATE TABLE FlightCancellations
    (
        CancellationID INT IDENTITY(1,1) PRIMARY KEY,
        FlightNumber VARCHAR(10),
        DepartureAirport CHAR(3),
        ArrivalAirport CHAR(3),
        OriginalDepartureTime DATETIME,
        CancellationTime DATETIME DEFAULT GETDATE()
    );
END;


IF NOT EXISTS (
    SELECT *
    FROM sys.tables
    WHERE name = 'PassengerNotifications'
)
BEGIN
    CREATE TABLE PassengerNotifications
    (
        NotificationID INT IDENTITY(1,1) PRIMARY KEY,
        PassengerID INT,
        FlightNumber VARCHAR(10),
        NotificationType VARCHAR(50),
        NotificationMessage VARCHAR(500),
        NotificationTime DATETIME DEFAULT GETDATE(),
        IsRead BIT DEFAULT 0
    );
END;

